# Copy to .env and fill in. Never commit .env.

# Cognee LLM: Anthropic Claude key (sk-ant-...)
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/claude-haiku-5-5
# Cognee embeddings: local fastembed model, no key needed
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Single-user local mode (no login needed)
ENABLE_BACKEND_ACCESS_CONTROL=false

# Flexprice (US region; use https://api.cloud.flexprice.io/v1 for India)
FLEXPRICE_API_KEY=
FLEXPRICE_API_URL=https://us.api.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=demo-startup

# Snyk: either run `snyk auth` once, or set a token here
SNYK_TOKEN=
